# ---------- Pflicht ----------
# Öffentliche Adresse der Plattform (ohne Schrägstrich am Ende)
APP_URL=https://swissowners.ch

# MySQL-Datenbank aus dem Hostinger hPanel (Datenbanken > MySQL-Datenbanken)
# Format: mysql://BENUTZER:PASSWORT@HOST:3306/DATENBANK
DATABASE_URL=mysql://u123456789_swissowners:PASSWORT@localhost:3306/u123456789_swissowners

# Zufälliger, langer Wert für den täglichen Abrechnungs-Job (z. B. openssl rand -hex 32)
CRON_SECRET=bitte-ersetzen

# E-Mail-Adressen, die beim Registrieren automatisch Admin-Rechte erhalten (kommagetrennt)
ADMIN_EMAILS=info@swissowners.ch

# ---------- E-Mail-Versand (Hostinger Mail) ----------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=noreply@swissowners.ch
SMTP_PASS=bitte-ersetzen
MAIL_FROM="SwissOwners <noreply@swissowners.ch>"
# Kopie aller Admin-Benachrichtigungen (neue Inserate zur Prüfung)
ADMIN_NOTIFY_EMAIL=info@swissowners.ch

# ---------- Payrexx ----------
# Instanzname = Subdomain, z. B. "swissowners" bei swissowners.payrexx.com
PAYREXX_INSTANCE=swissowners
PAYREXX_API_SECRET=bitte-ersetzen
PAYREXX_API_BASE=https://api.payrexx.com/v1.0

# ---------- Startangebot ----------
# Gratis-Inserate (60 Tage, Leistungen wie Plus) für die ersten N Inserate, längstens bis Datum
START_FREE_SLOTS=50
START_FREE_UNTIL=2027-01-31
