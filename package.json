    "next": "^16.4.2",
    "nodemailer": "^10.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/nodemailer": "^7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
