{
  "name": "anteo",
  "version": "0.1.0",
  "private": true,
  "description": "anteo.swiss – Inseratemarkt für Anteile an Schweizer KMU und Startups",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
